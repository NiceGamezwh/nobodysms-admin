# 复制本文件为 .env.local 后填写私钥与 RPC（切勿提交 .env.local）
# cp .env.example .env.local

# Sepolia JSON-RPC（Alchemy / Infura / 自建节点均可）
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# 合约 Owner 私钥（必须带 0x 前缀）。仅服务端使用，不会进浏览器。
ADMIN_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# 可选：设置后访问 UI / API 需要密码；留空则完全开放（仅本机开发时建议）
# ADMIN_PASSWORD=

# —— 合约地址（Sepolia 已部署，一般无需改）——
VEETO_BEARER_REGISTRY=0x668abf17783ADb0F26cdD9049736C6954a6378CF
MEMBER_CARD_3=0xFd2d0EaEe67C0393f5218b8045824072f3727bAd
MEMBER_CARD_15=0xB482054498Fd24B8D55eB6A9AA26fA4fb18eAE85
MEMBER_CARD_30=0x9c06E39BE91e348dbCAc3A9338fC7c1E002A54A3
